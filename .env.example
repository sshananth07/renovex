# --- Server ---
APP_ENV=development
HTTP_PORT=8080

# --- F0A: Browser integration (CORS, refresh-cookie security) ---
# APP_ALLOWED_ORIGINS is a comma-separated list of EXACT browser origins
# (scheme + host + optional port, no path/query/fragment/credentials)
# permitted to make credentialed CORS requests and to pass the
# /auth/refresh and /auth/logout Origin guard. Empty is valid outside
# production; production requires at least one entry, and every entry must
# use https.
#
# AUTH_REFRESH_COOKIE_SECURE controls the refresh_token cookie's Secure
# attribute. Defaults to true. Only development/test environments may set
# it false (over plain http://localhost); production may not — LoadFromEnv
# fails startup if APP_ENV=production and this is false.
#
# Development example (this file's defaults):
APP_ALLOWED_ORIGINS=http://localhost:3000
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAME_SITE=lax
#
# Production example (do not use in this file — for reference only):
#   APP_ENV=production
#   APP_ALLOWED_ORIGINS=https://app.example.com
#   AUTH_REFRESH_COOKIE_SECURE=true
#   AUTH_REFRESH_COOKIE_SAME_SITE=none
#   MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net (never localhost/127.0.0.1)
#   OBJECT_STORE_PROVIDER=r2 (never "local" — LoadFromEnv fails startup otherwise)
#   EMAIL_DELIVERY_MODE=direct (never "test_sink" — LoadFromEnv fails startup otherwise)

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DATABASE=renovation_platform

# --- JWT (reserved for Milestone 1; not used by Milestone 0) ---
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret

# --- Email (Mailpit, local dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@renovation-platform.local

# --- File storage ---
STORAGE_LOCAL_PATH=./data/uploads

# --- AI Gateway ---
# AI_PROVIDER is currently unused by the Go backend itself (the real
# provider selector lives in ai-service/.env's own AI_PROVIDER) — kept here
# only as a legacy/reserved field; do not rely on it to change Go behavior.
AI_PROVIDER=mock

# --- M8.5B-A: Go -> Python AI service HTTP client ---
# AI_SERVICE_URL/AI_INTERNAL_TOKEN are required together — either both are
# set (AI Project Setup suggestion generation is enabled) or neither is
# (the feature is simply unavailable). AI_INTERNAL_TOKEN is a Go<->Python-
# only shared secret — must match INTERNAL_API_TOKEN in ai-service/.env.
# Never reaches the browser, MongoDB, or public OpenAPI.
# AI_SERVICE_URL=http://localhost:8000
# Production uses only the AI service origin, e.g.
# AI_SERVICE_URL=https://<renovex-ai>.vercel.app
# Do not append /api/index or an internal route: the Go client owns the
# /internal/v1/... path suffix.
# AI_INTERNAL_TOKEN=<shared secret, matches ai-service's INTERNAL_API_TOKEN>
AI_SERVICE_TIMEOUT=45s

# --- RP4E1: Conversational spatial design reasoning ---
# Reuses AI_SERVICE_URL/AI_INTERNAL_TOKEN above — this route lives on the
# same FastAPI deployment. AI_SPATIAL_SERVICE_TIMEOUT is a SEPARATE,
# dedicated timeout for this route only; it must exceed the ai-service's
# own GLM_TIMEOUT_SECONDS. GLM_API_KEY is never read by Go — it exists only
# in ai-service/.env.
AI_SPATIAL_SERVICE_TIMEOUT=45s
SPATIAL_DESIGN_CONTEXT_RADIUS_METERS=3
ASSET_GENERATION_RUNTIME_NOTICE_ENABLED=true
# ASSET_GENERATION_RUNTIME_NOTICE_TEXT=Custom notice shown when 3D generation is required.

# --- RP4E0: Go -> Hugging Face Hunyuan3D runtime (private Gradio Space) ---
# HUGGINGFACE_SPACE_URL/HUGGINGFACE_TOKEN are required together — either
# both are set (3D asset generation is enabled) or neither is (the feature
# is simply unavailable, matching AI_SERVICE_URL/AI_INTERNAL_TOKEN's exact
# precedent). HUGGINGFACE_TOKEN never reaches the browser.
# HUGGINGFACE_SPACE_URL=https://<your-space>.hf.space
# HUGGINGFACE_TOKEN=<hugging face access token with access to the private Space>
# HUNYUAN_PROVIDER_TIMEOUT defaults to 110s if unset — the deployed Space
# runs under @spaces.GPU(duration=90) (90s GPU execution budget); 110s adds
# a small transport/queue/serialization margin without matching the GPU
# budget exactly (the two are not the same clock).
HUNYUAN_PROVIDER_TIMEOUT=110s

# --- Milestone 6: Client access links ---
# Absolute browser-facing application origin used to build scoped Client and
# Supplier portal links. The frontend route then calls the API directly; the
# path and opaque credential format remain owned by the backend.
# Must be an absolute URL (scheme + host) or the process fails to start.
EXTERNAL_API_BASE_URL=http://localhost:3000

# --- Milestone 8: Supplier Invitation secret keyring ---
# Supplier Invitation secrets are DERIVED from these keys, never stored. Only a
# hash, the access generation and the key version are persisted, which is what
# lets "copy secure link" reproduce the current link without rotating it.
#
# Rules:
#   - each key must decode to AT LEAST 32 random bytes;
#   - a missing, malformed or undersized key FAILS STARTUP;
#   - never auto-generate a key per boot: previously issued links would stop
#     being reproducible;
#   - an old key must remain configured while any invitation still records its
#     version.
#
# To rotate, add the next version and point ACTIVE_VERSION at it, keeping the
# previous key in place:
#   INVITATION_SECRET_KEY_V2=<new base64 key>
#   INVITATION_SECRET_ACTIVE_VERSION=2
#
# Generate a key with:
#   openssl rand -base64 32
#
# Compromise of one of these keys is wider in blast radius than one leaked
# invitation link: it forges every link derivable from that version. Keep keys
# out of MongoDB, never log them, and on compromise rotate the active key AND
# increment the affected invitations' access generations.
INVITATION_SECRET_ACTIVE_VERSION=1
INVITATION_SECRET_KEY_V1=ZGV2ZWxvcG1lbnQtb25seS1pbnZpdGF0aW9uLWtleS12MQ==

# --- M8.5C RP4E2/RP4E3: R2 object storage (Go backend) ---
# OBJECT_STORE_PROVIDER=local keeps the existing three local filesystem
# roots (development default). OBJECT_STORE_PROVIDER=r2 switches every
# spatial adapter (artifacts, asset-generation staging, visual assets,
# design references) onto ONE shared Cloudflare R2 bucket — R2's S3-
# compatible endpoint, talked to via the AWS SDK v2 S3 client (this is the
# documented way to use R2; no AWS account or AWS billing is involved). All
# five R2_* variables below are required together when
# OBJECT_STORE_PROVIDER=r2.
OBJECT_STORE_PROVIDER=local
# R2_ACCOUNT_ID=<cloudflare account id>
# R2_ACCESS_KEY_ID=<r2 api token access key id>
# R2_SECRET_ACCESS_KEY=<r2 api token secret>
# R2_BUCKET=renovex-tester
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- RP4D/RP4E0: local-object-store-only HMAC capability signing ---
# ONLY relevant when OBJECT_STORE_PROVIDER=local — in R2 mode, real R2
# presigned URLs are used instead and these keyrings are never consulted.
# Empty is valid (visual-asset/source-image access routes are simply
# unavailable); once configured, a malformed/undersized key fails startup.
# Generate with: openssl rand -base64 32
# VISUAL_ASSET_CAPABILITY_ACTIVE_VERSION=1
# VISUAL_ASSET_CAPABILITY_KEY_V1=<base64 key, >= 32 random bytes>
# VISUAL_ASSET_ACCESS_TTL=10m
# ASSET_GENERATION_SOURCE_CAPABILITY_ACTIVE_VERSION=1
# ASSET_GENERATION_SOURCE_CAPABILITY_KEY_V1=<base64 key, >= 32 random bytes>

# --- M8.5C RP4E2: reference-image generation response bound (Go side) ---
# Mirrors ai-service's own REFERENCE_IMAGE_MAX_BYTES — kept as separate
# configuration on each side deliberately; Go never trusts Python's
# self-reported bound.
REFERENCE_IMAGE_MAX_BYTES=8388608

# --- M8.5C: email provider / test-sink delivery ---
# EMAIL_PROVIDER=smtp (local Mailpit, matches SMTP_* above) or
# EMAIL_PROVIDER=resend (tester/production, requires RESEND_API_KEY and
# RESEND_FROM together). EMAIL_DELIVERY_MODE=direct sends to the real
# logical recipient; EMAIL_DELIVERY_MODE=test_sink redirects ONLY the
# outbound copy to EMAIL_TEST_SINK_ADDRESS (Mongo/domain records always
# keep the real recipient) — REQUIRES EMAIL_TEST_SINK_ADDRESS to be set.
# APP_ENV=production with EMAIL_DELIVERY_MODE=test_sink is a FATAL
# configuration error; the tester-only escape hatch can never reach a real
# deployment.
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_MODE=direct
# EMAIL_TEST_SINK_ADDRESS=<resend account inbox, e.g. your-resend-account@example.com>
# RESEND_API_KEY=<resend api key>
# RESEND_FROM=Renovex <onboarding@resend.dev>

# --- M8.5C RP4E0/RP4E2: bounded worker + Vercel Queue wake path ---
# SPATIAL_WORKER_TOKEN protects the internal process-one worker routes
# (Gate 2's bounded RP4E2/RP4E0 phase steps) — a separate secret from
# AI_INTERNAL_TOKEN (Go<->Python). SPATIAL_QUEUE_ENQUEUE_URL/TOKEN
# configure Go's call into the Web project's internal enqueue bridge; both
# stay unset in local/dev, where the existing in-process ticker (never
# started when SERVERLESS_MODE=true) drives asset generation instead.
# SPATIAL_WORKER_TOKEN=<random secret>
# SPATIAL_QUEUE_ENQUEUE_URL=https://<web-project>/api/internal/spatial-generation/enqueue
# SPATIAL_QUEUE_ENQUEUE_TOKEN=<random secret, shared with the Web project>

# --- M8.5C: serverless (Vercel) execution mode ---
# SERVERLESS_MODE=true tells the composition root never to start the local
# in-process asset-generation dispatch ticker — Vercel's bounded runtime
# cannot host a long-lived background loop. api/index.go's Vercel
# entrypoint sets this internally; cmd/api's own binary (this file's
# defaults) always runs with it false.
SERVERLESS_MODE=false
