# --- Environment ---
# "development" (default) or "production". T2D: ENVIRONMENT=production
# fails startup if AI_PROVIDER/SPATIAL_AI_PROVIDER/REFERENCE_IMAGE_PROVIDER
# is still "mock" — mirrors the Go backend's own APP_ENV=production guards.
ENVIRONMENT=development

# --- Provider selection ---
# mock is deterministic/offline and is the default for tests and local dev.
AI_PROVIDER=mock

# --- Internal service auth ---
# Shared bearer token Go presents on every /internal/v1/* request. Must match
# AI_INTERNAL_TOKEN in the Go backend's own .env. Never reaches the browser,
# MongoDB, public OpenAPI, or Gemini.
INTERNAL_API_TOKEN=changeme-internal-token

# --- Gemini (development provider only) ---
# Exists only in this service's runtime configuration. Never logged, never
# persisted, never sent anywhere except the official google-genai client.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Provider retry policy ---
AI_PROVIDER_MAX_RETRIES=2

# --- RP4E1: Conversational spatial design reasoning ---
# Isolated from AI_PROVIDER above — mock is deterministic/offline and is the
# default. Set to "glm" to use the real GLM provider — one outbound attempt
# per turn for almost every outcome, except a bounded 3-attempt retry for
# Z.ai's own transient-overload signal (HTTP 429, error.code=="1305").
SPATIAL_AI_PROVIDER=mock

# GLM_API_KEY exists only in this service's runtime configuration. Never
# logged, never persisted, never sent to Go — the Go backend has no
# GLM_API_KEY config field at all.
GLM_API_KEY=
GLM_MODEL=glm-5.3
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# 90s: production evidence showed a valid request timing out at exactly the
# previous 30s default — Z.ai occasionally needs longer than 30s to respond,
# even for a successful request.
GLM_TIMEOUT_SECONDS=90
GLM_MAX_OUTPUT_TOKENS=2000
GLM_REASONING_EFFORT=low

# --- RP4E2: reference-image generation ---
# Isolated from both AI_PROVIDER and SPATIAL_AI_PROVIDER above — mock is
# deterministic/offline and is the default. Set to "cloudflare" to use the
# real Cloudflare Workers AI FLUX.1-schnell provider (never retried; at
# most one outbound attempt per attempt's reference phase).
REFERENCE_IMAGE_PROVIDER=mock

# CLOUDFLARE_ACCOUNT_ID/CLOUDFLARE_API_TOKEN exist only in this service's
# runtime configuration. Never logged, never persisted, never sent to Go.
# Both are required together only when REFERENCE_IMAGE_PROVIDER=cloudflare
# — a missing/invalid credential disables only the reference-image route,
# never the rest of the service.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
REFERENCE_IMAGE_TIMEOUT_SECONDS=45
REFERENCE_IMAGE_MAX_BYTES=8388608
